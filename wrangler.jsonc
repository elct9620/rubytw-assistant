{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rubytw-assistant",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-27",
  "compatibility_flags": ["nodejs_compat"],
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.md"],
      "fallthrough": true,
    },
  ],
  "vars": {
    "SUMMARY_HOURS": "24",
    "SUMMARY_ITEM_LIMIT": "30",
    "FOLLOWUP_TOKEN_BUDGET": "400000",
    "AI_MODEL": "gpt-6-luna",
    "AI_GATEWAY_ID": "rubytw",
    "MEMORY_ENTRY_LIMIT": "32",
    "MEMORY_DESCRIPTION_LIMIT": "128",
    "MEMORY_SUMMARY_LENGTH_LIMIT": "300",
    "ISSUE_BODY_LENGTH_LIMIT": "500",
    "DISCORD_GUILD_ID": "1245197991191642262",
    "DISCORD_OPERATOR_ROLE_ID": "1245940501048459336",
    "GITHUB_ORG": "rubytaiwan",
    "GITHUB_REPO": "community-operation",
    "GITHUB_PROJECT_NUMBER": "1",
    "DEBUG_MODE": "false",
    "LANGFUSE_BASE_URL": "https://us.cloud.langfuse.com",
  },
  "ai": {
    "binding": "AI",
    "remote": true,
  },
  "kv_namespaces": [
    {
      "binding": "MEMORY_KV",
      "id": "9dcf2589f66143aa8ed7128177d76d19",
    },
    // Binding name is fixed by @cloudflare/workers-oauth-provider.
    {
      "binding": "OAUTH_KV",
    },
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true
    },
    "issues": {
      "enabled": true
    },
  },
  "triggers": {
    "crons": ["0 16 * * *"],
  },
  // Secrets (set via `wrangler secret put`):
  // - DISCORD_PUBLIC_KEY
  // - DISCORD_BOT_TOKEN
  // - DISCORD_CHANNEL_ID
  // - DISCORD_CLIENT_ID
  // - DISCORD_CLIENT_SECRET
  // - GITHUB_APP_ID
  // - GITHUB_PRIVATE_KEY
  // - GITHUB_INSTALLATION_ID
  // - ENVIRONMENT (e.g. "production")
  // - LANGFUSE_PUBLIC_KEY (optional)
  // - LANGFUSE_SECRET_KEY (optional)
}
